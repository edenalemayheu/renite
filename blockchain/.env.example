# =============================================================
# Renite Blockchain -- Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored -- never commit real keys or secrets.
#
# These variables are read by hardhat.config.ts via Hardhat's
# configVariable() API at deploy/script time.
#
# The same BLOCKCHAIN_RPC_URL and BLOCKCHAIN_PRIVATE_KEY names
# are reused by the backend service layer so both sides share
# one wallet configuration (see backend/services/blockchain.service.js).
# =============================================================


# -------------------------------------------------------------
# Sepolia testnet -- deployment and live interaction
# -------------------------------------------------------------

# JSON-RPC endpoint for Sepolia testnet.
# Obtain a free endpoint from Infura, Alchemy, or QuickNode.
# Example: https://sepolia.infura.io/v3/YOUR_PROJECT_ID
SEPOLIA_RPC_URL=

# Private key of the deployer / backend signing wallet.
# This wallet must hold Sepolia ETH to pay for gas.
#
# When using hardhat-keystore (recommended):
#   npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#   The key is stored encrypted; do NOT paste it here.
#
# When setting as a plain environment variable:
#   Provide the full 66-character hex string including the 0x prefix.
#   Example: 0xabc123...  (64 hex chars after 0x)
SEPOLIA_PRIVATE_KEY=


# -------------------------------------------------------------
# Backend service integration
# Used by backend/services/blockchain.service.js
# -------------------------------------------------------------

# Set to exactly "true" to activate on-chain anchoring in the backend.
# Any other value (including empty) keeps the integration disabled.
# Safe default: leave as false during development and CI.
BLOCKCHAIN_ENABLED=false

# JSON-RPC endpoint the backend process uses to submit transactions.
# Can be the same value as SEPOLIA_RPC_URL above, or a separate one.
BLOCKCHAIN_RPC_URL=

# Private key of the backend signing wallet (with 0x prefix).
# This is the wallet whose address becomes the on-chain owner of every
# registered device. Keep this key secret and never commit it.
BLOCKCHAIN_PRIVATE_KEY=

# Address of the deployed DeviceRegistry contract.
# Populated after running: npx hardhat ignition deploy ignition/modules/DeviceRegistry.ts
# The address is written to: ignition/deployments/<id>/deployed_addresses.json
BLOCKCHAIN_CONTRACT_ADDR=
