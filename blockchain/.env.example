# ─── Renite Blockchain – Environment Variables ───────────────────────────────
#
# Copy this file to .env and fill in the values for your target network.
# The .env file is git-ignored; never commit real private keys.
#
# Required only for Sepolia deployments:
#   npx hardhat ignition deploy --network sepolia ignition/modules/DeviceRegistry.ts

# RPC endpoint for Sepolia testnet (e.g. Alchemy / Infura URL)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the deployer wallet (with test ETH on Sepolia)
SEPOLIA_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
