NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (see config/db.js)
MONGODB_URL=

# Separate database for automated tests (tests/*.test.js) -- use a local
# Mongo instance (see docker-compose.yml) or a dedicated test cluster,
# never your real Atlas data.
TEST_MONGODB_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CORS_ORIGIN=

# ------------------------------------------------------------------
# Blockchain integration (optional -- disabled by default)
# See blockchain/.env.example for full documentation.
# ------------------------------------------------------------------

# Set to exactly "true" to activate on-chain anchoring.
# Leave unset or set to any other value to disable (safe default).
BLOCKCHAIN_ENABLED=false

# JSON-RPC endpoint for the network where DeviceRegistry is deployed.
# Example (Sepolia via Infura): https://sepolia.infura.io/v3/YOUR_KEY
BLOCKCHAIN_RPC_URL=

# Private key of the backend signing wallet (0x-prefixed hex, 66 chars).
# This wallet pays gas and becomes the on-chain owner of registered devices.
# NEVER commit a real private key. Use a secret manager in production.
BLOCKCHAIN_PRIVATE_KEY=

# Deployed DeviceRegistry contract address.
# Obtain this after running: npx hardhat ignition deploy (in blockchain/)
BLOCKCHAIN_CONTRACT_ADDR=
